{
  "repositories": ["example-org/service", "example-org/dashboard"],
  "labels": {
    "ready": "rt:ready",
    "inProgress": "rt:in-progress",
    "needsHuman": "needs-human",
    "hold": "hold"
  },
  "namespace": "roundtable",
  "chainPrefix": "pr-pipeline-",
  "rebase": "dispatch",
  "leadKnight": "rt-lead",
  "knights": {
    "example-org/dashboard": "rt-ui",
    "*": "rt-operator"
  },
  "botAuthor": "^(dunce-bot|app/.*)$",
  "ciMaxAgeHours": 24,
  "fixCheckMinutes": 20
}
