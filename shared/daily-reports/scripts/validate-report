#!/usr/bin/env bash
# Check a knight daily report against the contract in assets/contract.schema.json.
#   validate-report <report.json>      ("-" reads stdin)
# Every problem is printed on stderr, one per line, prefixed with its JSON path.
# Valid:   last stdout line "validate-report: ok", exit 0.
# Invalid: last stdout line "Outcome: failed report invalid: <first problem>", exit 1.
# Exit 2 on bad arguments or an unreadable file.
# Needs bash and jq (no jsonschema/ajv). Keep the rules below in step with the
# schema; tests/test.sh asserts that they match.
set -euo pipefail

usage() {
  echo "usage: validate-report <report.json|->" >&2
  exit 2
}

[ $# -eq 1 ] || usage
case "$1" in
  -h|--help) usage ;;
  -) src="/dev/stdin" ;;
  *)
    src="$1"
    if [ ! -f "$src" ] || [ ! -r "$src" ]; then
      echo "validate-report: cannot read $src" >&2
      exit 2
    fi
    ;;
esac

input="$(cat "$src")" || { echo "validate-report: cannot read $1" >&2; exit 2; }

if ! printf '%s' "$input" | jq . >/dev/null 2>&1; then
  problems="$(printf '%s\n' '$: not valid JSON')"
else
  # shellcheck disable=SC2016  # jq program, not shell
  problems="$(printf '%s' "$input" | jq -r '
    def show: tojson;
    def tname: if . == null then "null" else type end;
    def need_string($p): if type != "string" then "\($p): \(show) is not a string" else empty end;
    def need_enum($p; $vals):
      if type != "string" or (. as $v | $vals | index($v)) == null
      then "\($p): \(show) is not one of \($vals | join("|"))" else empty end;
    def need_strings($p):
      if type != "array" then "\($p): \(show) is not an array"
      else to_entries[] | select(.value | type != "string")
           | "\($p)[\(.key)]: \(.value | show) is not a string" end;

    # schema: required (top level)
    ["knight","run_id","report_type","timestamp","summary","sections","highlights","follow_up_needed","follow_up_questions"] as $req
    # schema: sections[].required
    | ["title","priority","content","data_sources","confidence"] as $sreq
    # schema: enum of priority / confidence
    | ["high","medium","low"] as $levels
    # schema: highlights.maxItems
    | 5 as $maxhl
    | if type != "object" then "$: top level is \(tname), not an object"
      else
        . as $r
        | ($req[] | . as $k | select($r | has($k) | not) | "\($k): required key is missing"),
          (if has("knight") then .knight | need_string("knight") else empty end),
          (if has("run_id") then
             .run_id | if type != "string" or (test("^daily-[0-9]{4}-[0-9]{2}-[0-9]{2}$") | not)
               then "run_id: \(show) does not match ^daily-YYYY-MM-DD$" else empty end
           else empty end),
          (if has("report_type") then
             .report_type | if . != "daily-briefing"
               then "report_type: \(show) is not daily-briefing" else empty end
           else empty end),
          (if has("timestamp") then
             .timestamp | if type != "string" or (test("^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?([Zz]|[+-][0-9]{2}:[0-9]{2})$") | not)
               then "timestamp: \(show) is not an ISO-8601 date-time" else empty end
           else empty end),
          (if has("summary") then .summary | need_string("summary") else empty end),
          (if has("sections") then
             .sections | if type != "array" then "sections: \(show) is not an array"
             elif length < 1 then "sections: must contain at least one section"
             else to_entries[] | .key as $i | .value as $s
               | if ($s | type) != "object" then "sections[\($i)]: \($s | show) is not an object"
                 else
                   ($sreq[] | . as $k | select($s | has($k) | not) | "sections[\($i)].\($k): required key is missing"),
                   (if $s | has("title") then $s.title | need_string("sections[\($i)].title") else empty end),
                   (if $s | has("priority") then $s.priority | need_enum("sections[\($i)].priority"; $levels) else empty end),
                   (if $s | has("content") then $s.content | need_string("sections[\($i)].content") else empty end),
                   (if $s | has("data_sources") then $s.data_sources | need_strings("sections[\($i)].data_sources") else empty end),
                   (if $s | has("confidence") then $s.confidence | need_enum("sections[\($i)].confidence"; $levels) else empty end)
                 end
             end
           else empty end),
          (if has("highlights") then
             .highlights | if type != "array" then "highlights: \(show) is not an array"
             elif length < 1 then "highlights: must contain at least 1 item"
             elif length > $maxhl then "highlights: \(length) items, at most \($maxhl) allowed"
             else need_strings("highlights") end
           else empty end),
          (if has("follow_up_needed") then
             .follow_up_needed | if type != "boolean" then "follow_up_needed: \(show) is not a boolean" else empty end
           else empty end),
          (if has("follow_up_questions") then .follow_up_questions | need_strings("follow_up_questions") else empty end)
      end
  ')" || { echo "validate-report: jq failed" >&2; exit 2; }
fi

if [ -n "$problems" ]; then
  printf '%s\n' "$problems" | sed 's/^/validate-report: /' >&2
  first="$(printf '%s\n' "$problems" | head -n 1)"
  echo "Outcome: failed report invalid: $first"
  exit 1
fi
echo "validate-report: ok"
