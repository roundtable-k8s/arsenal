#!/usr/bin/env bash
# Render a chain run record as a short markdown report.
#   render-run [run.json | -]     (reads stdin when no file or "-" is given)
# The record is the JSON from the gateway's get_run tool or GET /v1/runs/{namespace}/{run}.
# Only the record is used: no network, no environment variables. Markdown goes to stdout.
# Exit codes: 0 ok, 2 bad input (usage, unreadable file, not a JSON object, no run field).
set -euo pipefail

usage() {
  echo "usage: render-run [run.json | -]" >&2
  exit 2
}

[ $# -le 1 ] || usage
src="${1:--}"
if [ "$src" = "-" ]; then
  json="$(cat)"
else
  [ -r "$src" ] || { echo "render-run: cannot read $src" >&2; exit 2; }
  json="$(cat "$src")"
fi

if ! jq -e 'type == "object"' <<<"$json" >/dev/null 2>&1; then
  echo "render-run: input is not a JSON object" >&2
  exit 2
fi
if ! jq -e 'has("run") and (.run | type == "string" and length > 0)' <<<"$json" >/dev/null 2>&1; then
  echo "render-run: run record has no run field" >&2
  exit 2
fi

jq -r '
  def secs: sub("\\.[0-9]+"; "") | fromdateiso8601;
  def esc: tostring | gsub("[|]"; "\\|");
  . as $r
  | ($r.done == true) as $done
  | [$r.steps[]? | select((.error // "") != "")] as $failed
  | (if ($done | not) then "running" elif ($failed | length) > 0 then "failed" else "succeeded" end) as $status
  | (try (($r.completedAt | secs) - ($r.startedAt | secs)) catch null) as $d
  | (if ($done | not) then "still running"
     elif $d == null or $d < 0 then "unknown"
     elif $d < 60 then "\($d)s"
     elif $d < 3600 then "\($d / 60 | floor)m \($d % 60)s"
     else "\($d / 3600 | floor)h \(($d % 3600) / 60 | floor)m" end) as $dur
  | ($r.output // "") as $o
  | ($o | length) as $len
  | (([$o | scan("`+") | length] | max) // 0) as $ticks
  | (if $ticks + 1 > 3 then $ticks + 1 else 3 end) as $n
  | ("`" * $n) as $fence
  | ($len > 2000) as $cut
  | [
      "# Run report: \($r.chain // "unknown chain") (\($r.run))",
      "",
      "- Phase: \($r.phase // "-")",
      "- Status: \($status)",
      "- Started: \($r.startedAt // "not recorded")",
      "- Finished: \(if $done then ($r.completedAt // "not recorded") else "still running" end)",
      "- Duration: \($dur)",
      "",
      "## Steps",
      "",
      (if ($r.steps | length) == 0 then "_No steps recorded._"
       else ([ "| Step | Phase | Result |", "| --- | --- | --- |" ]
             + [$r.steps[] | "| \(.name // "-" | esc) | \(.phase // "-" | esc) | \(if (.error // "") != "" then "failed" else "ok" end) |"])
             | join("\n") end),
      ""
    ]
  + (if ($failed | length) > 0
     then ["## Errors", ""] + [$failed[] | "- **\(.name // "-" | esc)**: \(.error)"] + [""]
     else [] end)
  + ["## Output", ""]
  + (if $len == 0 then ["_No final output._"]
     else [$fence, $o[0:2000], $fence]
          + (if $cut then ["", "_Output truncated: showing the first 2000 of \($len) characters._"]
             elif $r.outputTruncated == true then ["", "_Output truncated by the gateway._"]
             else [] end)
     end)
  | join("\n")
' <<<"$json"
