#!/usr/bin/env bash
# Compare an old job's dated output with the new scheduled-knight output, day by day.
# A date file is any regular file whose name starts with YYYY-MM-DD and matches --pattern.
#
# Usage:
#   compare-outputs <old-dir> <new-dir> [--days N] [--pattern GLOB] [--today YYYY-MM-DD]
#   compare-outputs <old-dir> <new-dir> --diff YYYY-MM-DD [--pattern GLOB]
#
# Read-only: never writes into either directory.
# Exit: 0 report produced (or diff printed); 1 any day is only-old or new-empty;
#       2 bad arguments or unreadable directory.
set -uo pipefail

die() { echo "compare-outputs: $*" >&2; exit 2; }
usage() {
    echo "usage: compare-outputs <old-dir> <new-dir> [--days N] [--pattern GLOB] [--today YYYY-MM-DD] [--diff YYYY-MM-DD]" >&2
}

days=7
pattern='*.md'
today=''
diff_date=''
positional=()

while [ $# -gt 0 ]; do
    case "$1" in
        --days)    [ $# -ge 2 ] || die "--days needs a value"; days=$2; shift 2 ;;
        --pattern) [ $# -ge 2 ] || die "--pattern needs a value"; pattern=$2; shift 2 ;;
        --today)   [ $# -ge 2 ] || die "--today needs a value"; today=$2; shift 2 ;;
        --diff)    [ $# -ge 2 ] || die "--diff needs a value"; diff_date=$2; shift 2 ;;
        -h|--help) usage; exit 0 ;;
        --*)       usage; die "unknown option $1" ;;
        *)         positional+=("$1"); shift ;;
    esac
done

[ "${#positional[@]}" -eq 2 ] || { usage; die "need exactly <old-dir> and <new-dir>"; }
old=${positional[0]}
new=${positional[1]}

is_date() {
    [[ $1 =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || return 1
    [ "$(date -d "$1" +%F 2>/dev/null)" = "$1" ]
}

[[ $days =~ ^[1-9][0-9]*$ ]] || die "--days must be a positive integer"
[ -d "$old" ] && [ -r "$old" ] || die "cannot read old dir: $old"
[ -d "$new" ] && [ -r "$new" ] || die "cannot read new dir: $new"
if [ -z "$today" ]; then
    today=$(date +%F)
fi
is_date "$today" || die "--today must be a valid YYYY-MM-DD date"

# find_file <dir> <date>: print the first matching dated file, or return 1.
find_file() {
    local dir=$1 d=$2 f base
    for f in "$dir/$d"*; do
        [ -f "$f" ] || continue
        base=${f##*/}
        # shellcheck disable=SC2053
        [[ $base == $pattern ]] || continue
        printf '%s\n' "$f"
        return 0
    done
    return 1
}

if [ -n "$diff_date" ]; then
    is_date "$diff_date" || die "--diff needs a valid YYYY-MM-DD date"
    o=$(find_file "$old" "$diff_date" || true)
    n=$(find_file "$new" "$diff_date" || true)
    [ -n "$o" ] || [ -n "$n" ] || die "no file for $diff_date in either directory"
    tmp=$(mktemp)
    trap 'rm -f "$tmp"' EXIT
    diff -u --label "old ${o##*/}" --label "new ${n##*/}" \
        "${o:-/dev/null}" "${n:-/dev/null}" > "$tmp"
    total=$(wc -l < "$tmp")
    head -n 200 "$tmp"
    if [ "$total" -gt 200 ]; then
        echo "compare-outputs: diff truncated at 200 lines ($total total)"
    fi
    exit 0
fi

# verdict <old-file> <new-file> (empty string = missing)
verdict() {
    local o=$1 n=$2
    if [ -n "$n" ] && [ "$(stat -c %s "$n")" -lt 50 ]; then echo new-empty
    elif [ -n "$o" ] && [ -n "$n" ]; then echo both
    elif [ -n "$o" ]; then echo only-old
    elif [ -n "$n" ]; then echo only-new
    else echo neither
    fi
}

n_both=0; n_only_old=0; n_only_new=0; n_new_empty=0
for ((i = 0; i < days; i++)); do
    d=$(date -d "$today -$i days" +%F)
    o=$(find_file "$old" "$d" || true)
    n=$(find_file "$new" "$d" || true)

    if [ -n "$o" ]; then os=$(stat -c %s "$o"); oh=$(grep -c '^#' "$o" || true); else os=missing; oh=-; fi
    if [ -n "$n" ]; then ns=$(stat -c %s "$n"); nh=$(grep -c '^#' "$n" || true); else ns=missing; nh=-; fi

    if [ -n "$o" ] && [ -n "$n" ]; then
        if [ "$os" -gt 0 ]; then
            ratio=$(awk -v a="$ns" -v b="$os" 'BEGIN { printf "%.2f", a / b }')
        else
            ratio=n/a
        fi
    else
        ratio=-
    fi

    v=$(verdict "$o" "$n")
    case "$v" in
        both)      n_both=$((n_both + 1)) ;;
        only-old)  n_only_old=$((n_only_old + 1)) ;;
        only-new)  n_only_new=$((n_only_new + 1)) ;;
        new-empty) n_new_empty=$((n_new_empty + 1)) ;;
    esac
    echo "$d old=$os new=$ns ratio=$ratio old_headings=$oh new_headings=$nh verdict=$v"
done

echo "compare-outputs: $n_both day(s) both, $n_only_old only-old, $n_only_new only-new, $n_new_empty new-empty"
if [ $((n_only_old + n_new_empty)) -gt 0 ]; then
    exit 1
fi
exit 0
