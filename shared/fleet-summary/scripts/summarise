#!/usr/bin/env bash
# Summarise recent gateway activity from the JSON the gateway's MCP tools return:
# task counts by status and knight, total cost, the five slowest tasks, open dead
# letters grouped by reason, and (with --knights) the knights that are not ready.
#
# Usage:
#   summarise --tasks FILE --dead-letters FILE [--knights FILE] [--since ISO8601]
#
# Inputs: list_tasks -> {"tasks":[...]}, list_dead_letters -> {"deadLetters":[...]},
# list_knights -> {"knights":[...]}. --since keeps tasks by createdAt and dead letters
# by deadLetteredAt, at or after that time (Z or a +HH:MM/-HH:MM offset, e.g. 2026-11-26T00:00:00Z).
# Reads files only; jq is the only tool needed.
# Exit: 0 summary printed; 2 bad arguments, unreadable file, bad JSON or bad --since.
set -euo pipefail
export LC_ALL=C

die() { echo "summarise: $*" >&2; exit 2; }
usage() {
    echo "usage: summarise --tasks FILE --dead-letters FILE [--knights FILE] [--since ISO8601]" >&2
}

tasks=""; deadletters=""; knights=""; since=""
while [ $# -gt 0 ]; do
    case "$1" in
        --tasks)        [ $# -ge 2 ] || { usage; die "--tasks needs a value"; }; tasks=$2; shift 2 ;;
        --dead-letters) [ $# -ge 2 ] || { usage; die "--dead-letters needs a value"; }; deadletters=$2; shift 2 ;;
        --knights)      [ $# -ge 2 ] || { usage; die "--knights needs a value"; }; knights=$2; shift 2 ;;
        --since)        [ $# -ge 2 ] || { usage; die "--since needs a value"; }; since=$2; shift 2 ;;
        -h|--help) usage; exit 0 ;;
        *) usage; die "unknown option or argument: $1" ;;
    esac
done

[ -n "$tasks" ] && [ -n "$deadletters" ] || { usage; die "--tasks and --dead-letters are required"; }
if [ -n "$since" ] && ! [[ $since =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$ ]]; then
    die "--since must be ISO8601 with Z or a +HH:MM offset, e.g. 2026-11-26T00:00:00Z"
fi

# check_file <path> <array-key>: readable, JSON object whose key is an array
check_file() {
    [ -r "$1" ] || die "cannot read $1"
    jq -e --arg k "$2" 'type == "object" and (.[$k] | type == "array")' "$1" >/dev/null 2>&1 \
        || die "$1: not JSON with a \"$2\" array"
}
check_file "$tasks" tasks
check_file "$deadletters" deadLetters
[ -z "$knights" ] || check_file "$knights" knights

# Shared jq helpers. $since is passed with --arg; "" means no time filter.
defs='
def ts:
  . as $s
  | (($s | capture("(?<sign>[+-])(?<h>[0-9]{2}):(?<m>[0-9]{2})$")?) // null) as $o
  | ($s | sub("[+-][0-9]{2}:[0-9]{2}$"; "Z")) as $z
  | ((($z | sub("\\.[0-9]+Z$"; "Z")) | fromdateiso8601)
      + (($z | capture("\\.(?<f>[0-9]+)Z$")? | ("0." + .f) | tonumber) // 0))
    - (if $o == null then 0
       else (($o.h | tonumber) * 3600 + ($o.m | tonumber) * 60) * (if $o.sign == "-" then -1 else 1 end) end);
def within($stamp): $since == "" or (($stamp // "") != "" and (($stamp | ts) >= ($since | ts)));
'
jqr() { jq -r --arg since "$since" "$defs $1" "${@:2}"; }

if [ -n "$since" ]; then echo "Fleet summary since $since"; else echo "Fleet summary, all time"; fi

# ---- tasks ----
n_tasks=$(jqr '[.tasks[] | select(within(.createdAt))] | length' "$tasks") || die "$tasks: could not read tasks (bad JSON or timestamp)"
if [ "$n_tasks" -eq 0 ]; then
    echo "No tasks"
else
    echo "Tasks: $n_tasks"
    jqr '[.tasks[] | select(within(.createdAt))]
        | "  by status: " + (group_by(.status // "unknown") | map({k: (.[0].status // "unknown"), n: length})
            | sort_by([-.n, .k]) | map("\(.k)=\(.n)") | join(" ")),
          "  by knight: " + (group_by(.knight // "unknown") | map({k: (.[0].knight // "unknown"), n: length})
            | sort_by([-.n, .k]) | map("\(.k)=\(.n)") | join(" "))' "$tasks"
    # cost in 1e-4 dollars (integer), formatted here so the output never depends on jq number printing
    units=$(jqr '[.tasks[] | select(within(.createdAt)) | (.cost // 0)] | add // 0 | . * 10000 | round' "$tasks")
    printf '  total cost: $%d.%04d\n' "$((units / 10000))" "$((units % 10000))"
    echo "  slowest:"
    jqr '[.tasks[] | select(within(.createdAt))] | sort_by(-(.durationMs // 0)) | .[0:5][]
        | "    \((.durationMs // 0) | round) ms  \(.knight // "unknown")  \(.status // "unknown")  \(.taskId // "-")"' "$tasks"
fi

# ---- open dead letters ----
n_dl=$(jqr '[.deadLetters[] | select(.state == "open") | select(within(.deadLetteredAt))] | length' "$deadletters") \
    || die "$deadletters: could not read dead letters (bad JSON or timestamp)"
if [ "$n_dl" -eq 0 ]; then
    echo "No open dead letters"
else
    echo "Open dead letters: $n_dl"
    jqr '[.deadLetters[] | select(.state == "open") | select(within(.deadLetteredAt))]
        | group_by(.reason // "unknown") | .[]
        | "  \(.[0].reason // "unknown"): \(length)",
          (.[] | "    \(.knight // "unknown")  \(.taskId // "-")  \(.deadLetteredAt // "-")  "
            + ((.error // "") | split("\n") | .[0]
               | if . == null or . == "" then "(no error text)" else . end))' "$deadletters"
fi

# ---- knights ----
if [ -n "$knights" ]; then
    not_ready=$(jq -r '[.knights[] | select((.ready // false) | not) | (.name // "unknown")] | sort | join(", ")' "$knights") \
        || die "$knights: could not read knights"
    if [ -z "$not_ready" ]; then
        echo "Knights not ready: none"
    else
        echo "Knights not ready: $not_ready"
    fi
fi
